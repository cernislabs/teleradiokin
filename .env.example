# Copy to `.env` and adjust. Do NOT commit the real .env.
# These values are read by docker-compose and injected into the containers.

# --- Database ---
POSTGRES_USER=teleradio
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=teleradio

# --- Backend runtime ---
ENVIRONMENT=development

# --- JWT (auth) ---
# Jwt__Key must be a long random string (>= 32 chars) in any real deployment.
JWT_ISSUER=teleradiokin
JWT_AUDIENCE=teleradiokin-clients
JWT_KEY=dev-only-insecure-signing-key-change-me-0123456789

# --- Seed account passwords (development convenience) ---
SEED_ADMIN_PASSWORD=Admin!2345
SEED_RADIOLOGIST_PASSWORD=Radio!2345
SEED_CLINICIAN_PASSWORD=Clinic!2345
